# Reswap GCS — Environment variables
# Copy to .env and fill in values

# App
DEBUG=false
APP_NAME=Reswap GCS

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Local SQLite (default):
DATABASE_URL=sqlite:///./reswap.db
# Production PostgreSQL:
# DATABASE_URL=postgresql://reswap:yourpassword@localhost:5432/reswap_gcs

# CORS — add your frontend domain in production
CORS_ORIGINS=["http://localhost:3000","https://gcs.yourdomain.com"]

# Reroute engine
LOW_BATTERY_THRESHOLD_PCT=20
CRITICAL_BATTERY_PCT=10

# Swap defaults
SWAP_FEE_DEFAULT=12.0
OPERATING_HOURS=10
